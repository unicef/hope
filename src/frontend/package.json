{
  "name": "frontend",
  "version": "4.22.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build-for-backend": "bun run build --outDir '../hope/apps/web/static/web' --emptyOutDir",
    "build-and-watch": "bun run build-for-backend --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest",
    "preview": "vite preview",
    "generate-openapi": "cd ../.. && uv run python manage.py generate_openapi --output-dir src/frontend/data",
    "generate-openapi-docker": "docker exec development_tools-backend-1 python manage.py generate_openapi --output-dir src/frontend/data",
    "generate-rest-api-types": "bun run generate-rest-api-types-camelcase",
    "generate-rest-api-types-camelcase": "bun run generate-openapi && node enhance_and_camelize_openapi.js && openapi --input data/openapi-camelcase.yml --output src/restgenerated --useOptions --postfixModels CamelCase --exportCore false",
    "generate-rest-api-types-camelcase-docker": "bun run generate-openapi-docker && node enhance_and_camelize_openapi.js && openapi --input data/openapi-camelcase.yml --output src/restgenerated --useOptions --postfixModels CamelCase --exportCore false",
    "prune-unused-exports": "bunx ts-prune src | grep -v '(used in module)' | grep -v '/index.'"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-date-pickers": "^9.16.0",
    "@mui/x-tree-view": "9.16.0",
    "@sentry/react": "10.77.1",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "chart.js": "^4.6.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "formik": "^2.4.9",
    "i18next": "26.5.11",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "prop-types": "^15.8.1",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "15.0.0",
    "react-i18next": "17.1.9",
    "react-idle-timer": "^5.7.3",
    "react-router-dom": "7.18.5",
    "react-use": "^17.6.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "read-excel-file": "^9.3.13",
    "styled-components": "6.6.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "10.0.1",
    "@tanstack/eslint-plugin-query": "5.105.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "js-yaml": "^4.3.2",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "openapi-typescript-codegen": "^0.31.0",
    "prettier": "3.9.10",
    "ts-prune": "^0.10.3",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-csp-guard": "4.0.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/utils": "8.72.1",
    "minimatch": ">=9.0.5",
    "rollup": ">=4.59.0",
    "undici": "^7.30.1",
    "source-map-js": "^1.2.2",
    "brace-expansion": "^5.0.12",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "js-yaml": "^4.3.2",
    "handlebars": "^4.7.10",
    "zod": "^4.6.7"
  }
}
